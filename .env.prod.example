# ---- 数据库 ----
POSTGRES_DB=wuziqi
POSTGRES_USER=wuziqi
POSTGRES_PASSWORD=请改成强密码

# ---- 安全 ----
# 生成方式：openssl rand -base64 48
JWT_SECRET=请填入至少32字节的随机字符串
JWT_EXPIRE_DAYS=7

# ---- 站点 ----
# 用域名时：https://wuziqi.example.com
# 只有 IP 时：http://1.2.3.4
CORS_ORIGIN=http://127.0.0.1
HTTP_PORT=80

# ---- 对局 ----
RECONNECT_GRACE_SECONDS=30
